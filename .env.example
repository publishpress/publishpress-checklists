# Docker container name
CONTAINER_NAME="publishpress-checklists"

# Docker image name
TERMINAL_IMAGE_NAME="publishpress/dev-workspace-terminal:publishpress-checklists"

# Path to the cache directory for the dev-workspace
CACHE_PATH="./.cache"

# The slug of the plugin to be tested.
PLUGIN_SLUG="publishpress-checklists"

# The domain of the plugin to be tested.
LANG_DOMAIN="publishpress-checklists"

# The directory of the language files.
LANG_DIR="languages"

# OpenAI API key
OPENAI_API_KEY=sk-proj-your-openai-key

# WebLate API token
WEBLATE_API_TOKEN=wlu_your-weblate-token

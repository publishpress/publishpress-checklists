#: core/Mcp/Requirements.php:329
msgid "Use discovered requirement identifiers."
msgstr "Gamitin ang mga natuklasang identifier ng kinakailangan."

#: core/Mcp/Requirements.php:350
msgid "Settings changed. Read them again."
msgstr "Nabago ang mga setting. Basahin muli ang mga ito."

#: core/Mcp/Settings.php:47
msgid "Enable User Roles Filter (Who can ignore)"
msgstr "I-enable ang User Roles Filter (Sino ang maaaring mag-ignor)"

#: core/Mcp/Settings.php:48
msgid "Show warning icon"
msgstr "Ipakita ang icon ng babala"

#: core/Mcp/Settings.php:49
msgid "Highlight failing blocks in the editor"
msgstr "I-highlight ang mga nabigong bloke sa editor"

#: core/Mcp/Settings.php:50
msgid "Disable the Status option when using Quick Edit"
msgstr "I-disable ang opsyon sa Status kapag gumagamit ng Quick Edit"

#: core/Mcp/Settings.php:51
msgid "Disable Quick Edit completely"
msgstr "Ganap na i-disable ang Quick Edit"

#: core/Mcp/Settings.php:52

#: modules/settings/settings.php:1544
msgid "Allow admins to rename task labels for the post editor."
msgstr "Разрешить администраторам переименовывать метки задач для редактора постов."

#: modules/settings/settings.php:1562
msgid "Default"
msgstr "По умолчанию"

#: modules/settings/settings.php:1563
msgid "Priority"
msgstr "Приоритет"

#: modules/settings/settings.php:1564
msgid "Alphabetical"
msgstr "Алфавитный"

#: modules/settings/settings.php:1568
msgid "Keeps tasks in the order configured on the Checklists screen."
msgstr "Сохраняет задачи в порядке, установленном на экране контрольных списков."

#: modules/settings/settings.php:1572
msgid "Shows Required tasks before Recommended tasks."
msgstr "Показывает обязательные задачи перед рекомендованными задачами."

#: modules/settings/settings.php:1576
msgid "Sorts tasks alphabetically by task label."
msgstr "Сортирует задачи в алфавитном порядке по метке задачи."

#: modules/settings/settings.php:1619
msgid ""
"This will reset all renamed checklist labels for WP Admin and Editing "
"screen back to their default labels."
msgstr ""
"Это сбросит все переименованные метки контрольного списка для WP Admin и "
"экрана редактирования на их метки по умолчанию."

#: modules/settings/settings.php:1629
msgid "Security check failed."
msgstr "Проверка безопасности не удалась."

#: modules/settings/settings.php:1634
msgid "You do not have permission to perform this action."
msgstr "У вас нет разрешения на выполнение этого действия."

#: modules/settings/settings.php:1679
msgid "All renamed labels have been reset successfully."
msgstr "Все переименованные метки были успешно сброшены."


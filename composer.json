{
  "name": "publishpress/publishpress-checklists",
  "type": "wordpress-plugin",
  "description": "",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "PublishPress",
      "email": "help@publishpress.com"
    }
  ],
  "config": {
    "preferred-install": "dist",
    "allow-plugins": {
      "publishpress/dev-workspace": true,
      "php-http/discovery": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  },
  "require": {
    "php": ">=7.2.5"
  },
  "require-dev": {
    "publishpress/dev-workspace": "^1.0",
    "symfony/cache": "~7.3.0"
  },
  "minimum-stability": "stable",
  "extra": {
    "plugin-slug": "publishpress-checklists",
    "plugin-name": "publishpress-checklists",
    "plugin-folder": "publishpress-checklists",
    "version-constant": "PPCH_VERSION",
    "plugin-lang-domain": "publishpress-checklists",
    "plugin-github-repo": "publishpress/publishpress-checklists",
    "plugin-composer-package": "publishpress/publishpress-checklists"
  }
}
